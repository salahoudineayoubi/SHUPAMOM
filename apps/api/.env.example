# SHUPAMOM API — copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/shupamom
# Long random strings (e.g. `openssl rand -hex 48`). Different per environment.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Public base URL used to build audio URLs
PUBLIC_BASE_URL=http://localhost:4000
# development only: serve placeholder (non-validated) demo content, flagged. Always false in production.
SERVE_PLACEHOLDER_CONTENT=true

# Google Sign-In (same pattern as KolayExpress): OAuth client ids of the Google
# Cloud project. A Google ID token is accepted only if its audience is one of these.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

